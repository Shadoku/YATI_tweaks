# Exclude everything but the runtime importer from `git archive` ZIP downloads,
# so the archive can be dropped straight into a Godot project.
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
project.godot export-ignore
test export-ignore
supplemental export-ignore
CHANGELOG.md export-ignore
LICENSE export-ignore
README.md export-ignore
Reference.md export-ignore
Runtime.md export-ignore
icon.png export-ignore
