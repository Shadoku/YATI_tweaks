# Exclude everything but the runtime importer from `git archive` ZIP downloads,
# so the archive can be dropped straight into a Godot project.
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
project.godot export-ignore
test export-ignore
supplemental export-ignore
CHANGELOG.md export-ignore
LICENSE export-ignore
README.md export-ignore
Reference.md export-ignore
Runtime.md export-ignore
icon.png export-ignore
# The native importer is not part of the GDScript runtime's archive: its crate and tools are
# for building it, and its addon is useless (and prints errors on every start) without the
# platform libraries, which come from its own release zip (tools/install_native.sh).
native export-ignore
tools export-ignore
addons export-ignore
.godot-version export-ignore
.yati-native-version export-ignore
