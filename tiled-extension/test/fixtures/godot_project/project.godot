; Engine configuration file.
; A fixture for tiled-extension's tests: layer names with gaps, an [input] section whose values
; span lines, and settings the extension ignores.

config_version=5

[application]

config/name="Extension Fixture"
run/main_scene="res://scenes/enemy.tscn"
config/features=PackedStringArray("4.7")

[input]

jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"keycode":32,"unicode":32,"echo":false,"script":null)
, "[not a section]"]
}

