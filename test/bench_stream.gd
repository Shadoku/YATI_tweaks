extends SceneTree
## Stage 4 of docs/native-importer-plan.md: TiledStreamer under a camera scrolling at two screens
## per second, with the renderer (the frame times that matter are a rendered game's):
##
##   xvfb-run -a godot --path . --rendering-driver opengl3 --audio-driver Dummy -s test/bench_stream.gd
##   (user args after "--": --budget=4000 µs, --seconds=10, --only=map|world|iso, --verbose: the
##   worst frames with the streamer's work and counters in each)
##
## Two runs, each a Camera2D the streamer follows: a warm-up scroll elsewhere (unmeasured: the
## renderer compiles its shader variants the first time a kind of node is drawn, an 80 ms frame on
## this machine), the first window (unbounded budget), still frames, then the measured scroll
## (right for 40 % of the time, down for 30 %, left for 30 %), then the control: the streamer
## paused over a preloaded region, the camera scrolling back and forth at the same speed. The
## control's frames are the idle frames of a scrolling game; the streaming frames are compared
## with them quantile by quantile, since frame times on a shared machine with software GL spread
## widely by themselves (still frames' p95 is about 4 ms above their median, their worst 8):
##
## - map: test/out/stream/stream.tmx, an infinite map of 4000 x 4000 cells in 16 x 16 chunks
##   (4 tile layers, one with a collision polygon on every tile; an object in every third chunk),
##   loaded once (its load time and memory reported: Performance.MEMORY_STATIC, which counts the
##   engine's allocations only, and the process's resident memory, which counts the native
##   importer's Rust heap too);
## - iso: test/out/stream/stream_iso.tmx, the same content as an isometric map of 1024 x 1024
##   cells: its tile layers are y-sorted, so the engine draws every cell as its own canvas item
##   (no rendering quadrants) and the streamer budgets their cells at their own measured cost;
## - world: test/out/stream/stream.world, 3 x 3 finite maps of 256 x 256 cells on the same
##   tilesets, each loaded with TiledMap.load_async when the window comes near and unloaded when
##   it leaves.
##
## Reported per run: the still and control frames, the streaming frames' median, p95, p99 and
## worst against the control's, the histogram of the streaming frames' times above the control's
## median, the streamer's worst work in a frame, chunks loaded per second, the budget's hit rate
## (frames whose work stopped at the budget), the costs the streamer measured (µs per chunk, cell,
## collision cell, object...), and the gate: the streaming frames exceed the control's by no more
## than the budget plus one chunk's engine cost (2 ms with collision, section 1.3) at p99 and at
## the worst frame. The literal reading (the worst streaming frame against the control's median)
## is printed too.
## The maps are generated by test/gen_stream_bench.gd when missing.

const OUT := "res://test/out/stream/"
const CHUNK_ENGINE_MS := 2.0

var budget_us := 4000
var seconds := 10.0
var only := ""
var verbose := false
var _rows: Array = []
var _events: PackedStringArray = []
var _stamps: PackedInt64Array = []
var _work: PackedFloat64Array = []
var _streamer: Node2D = null
var _ok := true


func _initialize() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--budget="):
			budget_us = int(arg.substr(9))
		elif arg.begins_with("--seconds="):
			seconds = maxf(1.0, float(arg.substr(10)))
		elif arg.begins_with("--only="):
			only = arg.substr(7)
		elif arg == "--verbose":
			verbose = true
	if not ClassDB.class_exists("TiledStreamer"):
		printerr("bench_stream: the native library is not loaded (bash tools/build_native.sh)")
		quit(2)
		return
	run.call_deferred()


func run() -> void:
	if not FileAccess.file_exists(OUT + "stream.tmx") or not FileAccess.file_exists(OUT + "stream_iso.tmx") or not FileAccess.file_exists(OUT + "stream.world"):
		var out := []
		OS.execute(OS.get_executable_path(), ["--headless", "--path", ProjectSettings.globalize_path("res://"), "-s", "res://test/gen_stream_bench.gd"], out, true)
		print("".join(out).strip_edges())
	print("bench_stream: budget %d µs, %.0f s per run, viewport %s, %s, Godot %s" % [budget_us, seconds,
		root.get_visible_rect().size, DisplayServer.get_name() + " + " + str(RenderingServer.get_current_rendering_driver_name()),
		Engine.get_version_info()["string"]])
	process_frame.connect(_on_frame)
	if only == "" or only == "map":
		await bench_map()
	if only == "" or only == "iso":
		await bench_iso()
	if only == "" or only == "world":
		await bench_world()
	print("bench_stream: " + ("PASS" if _ok else "FAIL"))
	quit(0 if _ok else 1)


func _on_frame() -> void:
	_stamps.append(Time.get_ticks_usec())
	if _streamer != null and is_instance_valid(_streamer):
		var st: Dictionary = _streamer.call("get_stats")
		_work.append(float(st["last_work_us"]))
		if verbose:
			_rows.append([st["last_work_us"] / 1000.0, st["cells_set"], st["collision_cells_set"], st["tile_chunks_unloaded"], st["objects_spawned"], st["objects_despawned"], " ".join(_events)])
			_events.clear()


func rss_mb() -> float:
	var f := FileAccess.open("/proc/self/statm", FileAccess.READ)
	if f == null:
		return -1.0
	var parts := f.get_line().split(" ")
	return float(parts[1]) * 4096.0 / 1048576.0 if parts.size() > 1 else -1.0


func static_mb() -> float:
	return Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0


func bench_map() -> void:
	var path := OUT + "stream.tmx"
	var file_mb := FileAccess.get_file_as_bytes(path).size() / 1048576.0
	await frames(3)
	var s0 := static_mb()
	var r0 := rss_mb()
	var t0 := Time.get_ticks_usec()
	var map: RefCounted = ClassDB.instantiate("TiledMap")
	map.call("load", path, "")
	var load_ms := (Time.get_ticks_usec() - t0) / 1000.0
	await frames(3)
	var s1 := static_mb()
	var r1 := rss_mb()
	print("map: %s, %.1f MB file, loaded in %.0f ms; MEMORY_STATIC %.1f -> %.1f MB, resident %.1f -> %.1f MB (+%.1f MB, %.2f x the file)" % [
		path.get_file(), file_mb, load_ms, s0, s1, r0, r1, r1 - r0, (r1 - r0) / file_mb])
	var streamer: Node2D = ClassDB.instantiate("TiledStreamer")
	streamer.set("map", map)
	await run_case("map", streamer, Vector2(2000, 16000), Vector2(2000, 32000))
	await frames(3)
	print("map: after streaming: MEMORY_STATIC %.1f MB, resident %.1f MB (+%.1f MB over the loaded map)" % [static_mb(), rss_mb(), rss_mb() - r1])


func bench_iso() -> void:
	var map: RefCounted = ClassDB.instantiate("TiledMap")
	map.call("load", OUT + "stream_iso.tmx", "")
	var streamer: Node2D = ClassDB.instantiate("TiledStreamer")
	streamer.set("allow_y_sorted_layers", true)
	streamer.set("map", map)
	await run_case("iso", streamer, Vector2(3000, 6000), Vector2(3000, 8192), true)


func bench_world() -> void:
	var world: RefCounted = ClassDB.instantiate("TiledWorld")
	world.call("load", OUT + "stream.world", "")
	var streamer: Node2D = ClassDB.instantiate("TiledStreamer")
	streamer.set("world", world)
	var maps := []
	streamer.connect("map_loaded", func(p: String, _r: Node2D) -> void:
		maps.append("+" + p.get_file())
		_events.append("+" + p.get_file()))
	streamer.connect("map_unloaded", func(p: String) -> void:
		maps.append("-" + p.get_file())
		_events.append("-" + p.get_file()))
	await run_case("world", streamer, Vector2(1500, 9000), Vector2(1500, 1500))
	print("world: maps loaded/unloaded in order: " + " ".join(maps))


func run_case(label: String, streamer: Node2D, warm_start: Vector2, start: Vector2, iso: bool = false) -> void:
	var view := root.get_visible_rect().size
	var speed := Vector2(view.x * 2.0, view.y * 2.0)
	var cam := Camera2D.new()
	cam.position = warm_start
	root.add_child(cam)
	cam.make_current()
	# The window must cover the screen around the camera's chunk, plus a chunk to prefetch: on an
	# isometric map a screen is a diamond of cells, (w + h) / 2 / 16 cells from its centre each way
	var half := Vector2i(ceili(view.x / 2.0 / 16.0), ceili(view.y / 2.0 / 16.0))
	if iso:
		half = Vector2i.ONE * ceili((view.x + view.y) / 2.0 / 16.0)
	streamer.set("follow", cam)
	streamer.set("margin", half + Vector2i(16, 16))
	streamer.set("budget_us", 0)
	root.add_child(streamer)
	await settle(streamer)
	streamer.set("budget_us", budget_us)
	await scroll(cam, speed, 2.0, false)
	# The measured run's start: the first window, unbounded
	cam.position = start
	streamer.set("budget_us", 0)
	var t0 := Time.get_ticks_usec()
	var n := await settle(streamer)
	print("%s: first window settled in %d frames, %.0f ms (unbounded budget)" % [label, n, (Time.get_ticks_usec() - t0) / 1000.0])
	streamer.set("budget_us", budget_us)
	var still := await measure_still(90)
	streamer.call("reset_stats")
	_streamer = streamer
	_stamps.clear()
	_work.clear()
	await scroll(cam, speed, seconds, true)
	var times := deltas_ms()
	var work := _work.duplicate()
	_streamer = null
	if verbose:
		# Row i (read at the start of frame i) holds frame i-1's work, whose time is times[i-1]
		var idx: Array = range(times.size())
		idx.sort_custom(func(a: int, b: int) -> bool: return times[a] > times[b])
		print("%s: worst frames: ms | streamer work ms | cells | collision cells | chunks unloaded | objects spawned | despawned | events" % label)
		for i: int in idx.slice(0, 12):
			if i + 1 >= _rows.size():
				continue
			var r: Array = _rows[i + 1]
			var p: Array = _rows[i]
			print("  %.2f | %.2f | %d | %d | %d | %d | %d | %s" % [times[i], r[0], r[1] - p[1], r[2] - p[2], r[3] - p[3], r[4] - p[4], r[5] - p[5], r[6]])
	_rows.clear()
	var stats: Dictionary = streamer.call("get_stats")
	var costs: Dictionary = streamer.call("get_costs")
	# Control: the same scrolling speed over a preloaded region, the streamer paused: it follows a
	# still node at the camera with a margin that covers the camera's back-and-forth
	var c := cam.position
	var anchor := Node2D.new()
	anchor.position = c
	root.add_child(anchor)
	var reach := Vector2i(ceili((view.x * 1.5) / 16.0), ceili(view.y / 2.0 / 16.0)) + Vector2i(16, 16)
	if iso:
		reach = Vector2i.ONE * ceili((view.x * 1.5 + view.y / 2.0) / 16.0) + Vector2i(16, 16)
	streamer.set("follow", anchor)
	streamer.set("margin", reach)
	streamer.set("budget_us", 0)
	await settle(streamer)
	streamer.set_process(false)
	await frames(10)
	_stamps.clear()
	var t_start := Time.get_ticks_usec()
	var last := t_start
	var dir := 1.0
	while Time.get_ticks_usec() - t_start < seconds * 1e6:
		await process_frame
		var now := Time.get_ticks_usec()
		cam.position.x += dir * speed.x * (now - last) / 1e6
		last = now
		if absf(cam.position.x - c.x) > view.x:
			dir = -signf(cam.position.x - c.x)
	var control := deltas_ms()
	anchor.queue_free()
	report(label, still, control, times, work, stats, costs)
	streamer.queue_free()
	cam.queue_free()
	await frames(5)


## Frames until the streamer is settled (at most 3000).
func settle(streamer: Node2D) -> int:
	var n := 0
	while not streamer.call("is_settled") and n < 3000:
		await process_frame
		n += 1
	return n


## Scrolls the camera at `speed` (px/s) for `secs`: right for 40 % of the time, down for 30 %,
## left for 30 %.
func scroll(cam: Camera2D, speed: Vector2, secs: float, measured: bool) -> void:
	var t_start := Time.get_ticks_usec()
	var last := t_start
	while true:
		await process_frame
		var now := Time.get_ticks_usec()
		var el := (now - t_start) / 1e6
		if el >= secs:
			break
		var dt := (now - last) / 1e6
		last = now
		if el < secs * 0.4:
			cam.position.x += speed.x * dt
		elif el < secs * 0.7:
			cam.position.y += speed.y * dt
		else:
			cam.position.x -= speed.x * dt


func measure_still(count: int) -> float:
	_stamps.clear()
	await frames(count)
	var d := deltas_ms()
	d.sort()
	return d[d.size() / 2] if not d.is_empty() else 0.0


func frames(n: int) -> void:
	for i in n:
		await process_frame


func deltas_ms() -> PackedFloat64Array:
	var out := PackedFloat64Array()
	for i in range(1, _stamps.size()):
		out.append((_stamps[i] - _stamps[i - 1]) / 1000.0)
	return out


func quantiles(times: PackedFloat64Array) -> Array[float]:
	var sorted := times.duplicate()
	sorted.sort()
	if sorted.is_empty():
		return [0.0, 0.0, 0.0, 0.0]
	var q := func(p: float) -> float: return sorted[mini(sorted.size() - 1, int(p * sorted.size()))]
	return [q.call(0.5), q.call(0.95), q.call(0.99), sorted[sorted.size() - 1]]


func report(label: String, still: float, control_times: PackedFloat64Array, times: PackedFloat64Array, work: PackedFloat64Array, stats: Dictionary, costs: Dictionary) -> void:
	var t := quantiles(times)
	var c := quantiles(control_times)
	var idle := c[0]
	var edges: Array[float] = [1.0, 2.0, 4.0, 6.0, 8.0, 12.0, 16.0]
	var hist := PackedStringArray()
	for pair in [[times, "streaming"], [control_times, "control"]]:
		var counts: Array[int] = []
		counts.resize(edges.size() + 1)
		for f: float in pair[0]:
			var b := edges.size()
			for i in edges.size():
				if f - idle <= edges[i]:
					b = i
					break
			counts[b] += 1
		var parts := PackedStringArray()
		for i in counts.size():
			parts.append(("<=+%.0f: %d" % [edges[i], counts[i]]) if i < edges.size() else (">+%.0f: %d" % [edges[edges.size() - 1], counts[i]]))
		hist.append("%s %s" % [pair[1], ", ".join(parts)])
	var max_work := 0.0
	for w in work:
		max_work = maxf(max_work, w)
	# A frame's time less the streamer's work in it (work[i + 1] is read at the start of frame
	# i + 1, after frame i's step): what the engine charged beyond the work the streamer measured
	var rest := PackedFloat64Array()
	for i in times.size():
		rest.append(times[i] - (work[i + 1] / 1000.0 if i + 1 < work.size() else 0.0))
	var r := quantiles(rest)
	var work_frames: int = stats["work_frames"]
	print("%s: still frame median %.2f ms; control (scrolling, streamer paused) %d frames: median %.2f, p95 %.2f, p99 %.2f, worst %.2f ms" % [
		label, still, control_times.size(), c[0], c[1], c[2], c[3]])
	print("%s: streaming %d frames: median %.2f, p95 %.2f, p99 %.2f, worst %.2f ms; over the control: median %+.2f, p95 %+.2f, p99 %+.2f, worst %+.2f ms" % [
		label, times.size(), t[0], t[1], t[2], t[3], t[0] - c[0], t[1] - c[1], t[2] - c[2], t[3] - c[3]])
	print("%s: histogram of frame times over the control's median (ms): %s | %s" % [label, hist[0], hist[1]])
	print("%s: streaming frames less the streamer's work: median %.2f, p95 %.2f, p99 %.2f, worst %.2f ms; over the control: median %+.2f, p95 %+.2f, p99 %+.2f" % [
		label, r[0], r[1], r[2], r[3], r[0] - c[0], r[1] - c[1], r[2] - c[2]])
	print("%s: longest piece of work %.2f ms, most beyond its estimate %.2f ms" % [label, stats["max_item_us"] / 1000.0, stats["max_overrun_us"] / 1000.0])
	print("%s: streamer work per frame: worst %.2f ms; %d tile chunks loaded (%.0f/s), %d unloaded, %d objects spawned, %d despawned, %d cells (%d with collision); budget hit in %d of %d working frames (%.0f%%)" % [
		label, max_work / 1000.0, stats["tile_chunks_loaded"], stats["tile_chunks_loaded"] / seconds, stats["tile_chunks_unloaded"],
		stats["objects_spawned"], stats["objects_despawned"], stats["cells_set"], stats["collision_cells_set"],
		stats["budget_stops"], work_frames, 100.0 * stats["budget_stops"] / maxi(1, work_frames)])
	print("%s: measured costs (µs): chunk %.1f + cell %.2f (y-sorted %.2f) + collision cell %.2f; erase chunk %.1f + cell %.2f (y-sorted %.2f); objects chunk %.1f + object %.1f; free chunk %.1f + object %.1f (samples: tiles %d, erase %d, objects %d, free %d)" % [
		label, costs["chunk"], costs["cell"], costs["ysort_cell"], costs["collision_cell"], costs["erase_chunk"], costs["erased_cell"], costs["erased_ysort_cell"],
		costs["objects_chunk"], costs["object"], costs["free_chunk"], costs["freed_object"],
		costs["tile_samples"], costs["erase_samples"], costs["object_samples"], costs["free_samples"]])
	var limit := budget_us / 1000.0 + CHUNK_ENGINE_MS
	var ok_p99 := t[2] - c[2] <= limit
	var ok_worst := t[3] - c[3] <= limit
	print("%s: gate (streaming - control <= budget %.1f + chunk %.1f = %.1f ms): p99 %s, worst %s; literal (worst streaming frame - control median = %.2f ms): %s" % [
		label, budget_us / 1000.0, CHUNK_ENGINE_MS, limit, "PASS" if ok_p99 else "FAIL", "PASS" if ok_worst else "FAIL",
		t[3] - idle, "PASS" if t[3] - idle <= limit else "FAIL"])
	_ok = _ok and ok_p99 and ok_worst
