extends SceneTree
## Stage 3 of docs/native-importer-plan.md: the asynchronous import and the shared TileSet cache
## of the native importer (addons/yati_native/), headless:
##
## - the benchmark map (test/out/bench/bench.tmx, generated by test/benchmark.gd when absent)
##   imported with Importer.import_async() while every frame's main-thread time is measured (the
##   engine's headless frame sleep turned off, so a frame's wall time is its work): no
##   frame before the build frame above 5 ms, the build frame against the synchronous import's
##   build, the tree equal to the synchronous import's (node names, classes, counts, cells);
## - a second import of a map on the same tilesets creates no TileSet (get_created_count and
##   get_cached_count unchanged, tileset time ~0 ms); the exclusive shared cache builds a second
##   TileSet only while the first tree is alive;
## - cancelling (or dropping) a load mid-parse and mid-texture-load leaks nothing
##   (Performance.OBJECT_COUNT back at its baseline after a few frames, no loader thread left);
## - tile layers prepared by the load (TiledMap.prepare_tile_layers: on the worker for load_async)
##   give every TileMapLayer the tile_map_data a build that decodes them itself gives, and the
##   build then decodes nothing;
## - TiledMap's signals (a handler may call back into the map), zip, failures, counts.
##
##   godot --headless -s test/test_async.gd [-- --rounds=3]
##
## Prints one line per check and a SUMMARY; exit code 1 when a check fails, 2 without the library.

const ImporterScript := preload("res://addons/yati_native/Importer.gd")
const FIX := "res://test/fixtures/"
const BENCH := "res://test/out/bench/bench.tmx"
const BENCH_TILES := "res://test/out/bench/bench_tiles_only.tmx"
const FRAME_BUDGET_MS := 5.0
# The build frame may exceed the synchronous build by this much (a busy machine's noise)
const BUILD_TOLERANCE := 1.25

const READING := 0
const PARSING := 1
const WAITING_FILES := 2
const READY := 3
const FAILED := 4

var rounds := 3
var _stamps: PackedInt64Array = []
var _passed := 0
var _failed: PackedStringArray = []


func _initialize() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--rounds="):
			rounds = maxi(1, int(arg.substr(9)))
	if not ClassDB.class_exists("TiledMap"):
		printerr("test_async: the native library is not loaded (bash tools/build_native.sh)")
		quit(2)
		return
	# Headless, the engine sleeps until 6.9 ms have passed in every frame (it cannot draw): off,
	# so that a frame's wall time is the main thread's work in it.
	OS.low_processor_usage_mode_sleep_usec = 0
	process_frame.connect(_on_frame)
	main()


func _on_frame() -> void:
	_stamps.append(Time.get_ticks_usec())


func main() -> void:
	if not FileAccess.file_exists(BENCH) or not FileAccess.file_exists(BENCH_TILES):
		_generate_bench()
	if not FileAccess.file_exists(BENCH):
		printerr("test_async: no benchmark map at " + BENCH)
		quit(2)
		return
	# Warm-up, both ways, untimed: scripts, the engine's format check, resource caches, the
	# allocator's first large trees (the first build of each path in a process is slower)
	var warm: Node = ImporterScript.new().import(FIX + "layers.tmx")
	if warm: warm.free()
	warm = ImporterScript.new().import(BENCH)
	if warm: warm.free()
	await settle(3)
	warm = await ImporterScript.new().import_async(BENCH)
	if warm: warm.free()
	await settle(3)

	await test_bench_async_frames()
	await test_prepared_tile_layers()
	await test_second_import_skips_tilesets()
	await test_exclusive_shared_cache()
	await test_project_in_key()
	await test_cancel_leaks_nothing()
	await test_signals()
	await test_small_and_zip_equal_sync()
	await test_failures_and_counts()

	print("")
	print("SUMMARY: %d passed, %d failed" % [_passed, _failed.size()])
	for f in _failed:
		print("  FAILED: " + f)
	quit(0 if _failed.is_empty() else 1)


func check(cond: bool, what: String) -> bool:
	if cond:
		_passed += 1
		print("PASS " + what)
	else:
		_failed.append(what)
		print("FAIL " + what)
	return cond


func _generate_bench() -> void:
	print("test_async: generating the benchmark map (test/benchmark.gd)")
	var out: Array = []
	OS.execute(OS.get_executable_path(), ["--headless", "--path", ProjectSettings.globalize_path("res://"),
		"-s", "res://test/benchmark.gd", "--", "--runtime=res://addons/yati_native", "--iterations=1"], out, true)


func settle(frames: int = 10) -> void:
	for i in range(frames):
		await process_frame
		await physics_frame


func shared() -> RefCounted:
	return ImporterScript.shared_tilesets()


func cold_caches() -> void:
	shared().call("clear")
	shared().call("clear_textures")


## One line per node: its path, class, child count, metadata keys and, for a tile layer, its
## cell count (what "the same tree" means here).
func describe(n: Node) -> PackedStringArray:
	var lines: PackedStringArray = []
	_describe(n, "", lines)
	return lines


func _describe(n: Node, prefix: String, lines: PackedStringArray) -> void:
	var p := prefix + "/" + String(n.name)
	var line := "%s|%s|%d|%s" % [p, n.get_class(), n.get_child_count(), ",".join(n.get_meta_list())]
	if n is TileMapLayer:
		line += "|cells=%d" % (n as TileMapLayer).get_used_cells().size()
	lines.append(line)
	for c in n.get_children():
		_describe(c, p, lines)


func cell_count(n: Node) -> int:
	var total := 0
	for l in n.find_children("*", "TileMapLayer", true, false):
		total += (l as TileMapLayer).get_used_cells().size()
	return total


func median(a: Array[float]) -> float:
	var s := a.duplicate()
	s.sort()
	return s[s.size() / 2]


# ---------------------------------------------------------------------------

## The benchmark map through import_async with every frame timed, against the synchronous
## import of the same map (both with cold TileSet and texture caches).
func test_bench_async_frames() -> void:
	var worst_frames: Array[float] = []
	var build_frames: Array[float] = []
	var frame_counts: Array[int] = []
	var sync_builds: Array[float] = []
	var sync_totals: Array[float] = []
	var sync_loads: Array[float] = []
	var sync_tilesets: Array[float] = []
	var async_tree: PackedStringArray = []
	var sync_tree: PackedStringArray = []
	var async_cells := 0
	var sync_cells := 0
	for r in range(rounds):
		# Asynchronous
		cold_caches()
		await settle(3)
		var imp: Object = ImporterScript.new()
		await process_frame
		_stamps.clear()
		_stamps.append(Time.get_ticks_usec())
		var n: Node = await imp.import_async(BENCH)
		var t_done := Time.get_ticks_usec()
		var stamps := _stamps.duplicate()
		if not check(n != null, "bench async import returned a tree (round %d)" % r):
			return
		# Frame i is [stamps[i], stamps[i + 1]); the build ran in the last one, which ends at t_done
		var worst := 0.0
		var worst_at := -1
		for i in range(stamps.size() - 1):
			var ms := (stamps[i + 1] - stamps[i]) / 1000.0
			if ms > worst:
				worst = ms
				worst_at = i
		var build_ms := (t_done - stamps[stamps.size() - 1]) / 1000.0
		worst_frames.append(worst)
		build_frames.append(build_ms)
		frame_counts.append(stamps.size())
		print("  async round %d: %d frames, worst frame before the build %.2f ms (frame %d), build frame %.1f ms, errors %d, warnings %d" % [
			r, stamps.size(), worst, worst_at, build_ms, imp.last_error_count, imp.last_warning_count])
		if r == 0:
			async_tree = describe(n)
			async_cells = cell_count(n)
		n.free()
		await settle(3)

		# Synchronous, its phases timed with the native classes
		cold_caches()
		var map: RefCounted = ClassDB.instantiate("TiledMap")
		var t := Time.get_ticks_usec()
		map.call("load", BENCH, "")
		var t_load := Time.get_ticks_usec()
		var tilesets: RefCounted = ClassDB.instantiate("TiledTileSets")
		var opts: Resource = imp.call("make_options")
		tilesets.call("tileset_for", map, opts)
		var t_ts := Time.get_ticks_usec()
		var builder: RefCounted = ClassDB.instantiate("TiledBuilder")
		var s: Node = builder.call("build", map, tilesets, opts)
		var t_build := Time.get_ticks_usec()
		var tm: Dictionary = builder.call("get_timings")
		sync_loads.append((t_load - t) / 1000.0)
		sync_tilesets.append((t_ts - t_load) / 1000.0)
		sync_builds.append((t_build - t_ts) / 1000.0)
		sync_totals.append((t_build - t) / 1000.0)
		print("  sync round %d: load %.1f ms, TileSets %.1f ms, build %.1f ms (tile layers: decode %.1f, cells %.1f, tile_map_data %.1f), total %.1f ms" % [
			r, sync_loads[r], sync_tilesets[r], sync_builds[r], tm.prepare_us / 1000.0, tm.cells_us / 1000.0,
			tm.assign_us / 1000.0, sync_totals[r]])
		if r == 0:
			sync_tree = describe(s)
			sync_cells = cell_count(s)
		s.free()
		await settle(3)

	var worst_all: float = worst_frames.max()
	print("RESULT async bench: frames %s, worst frame before the build %.2f ms (max of %d rounds), build frame median %.1f ms (min %.1f); sync: load median %.1f, TileSets %.1f, build median %.1f (min %.1f), total median %.1f ms" % [
		str(frame_counts), worst_all, rounds, median(build_frames), build_frames.min(), median(sync_loads),
		median(sync_tilesets), median(sync_builds), sync_builds.min(), median(sync_totals)])
	check(worst_all < FRAME_BUDGET_MS, "no frame before the build frame above %.0f ms (worst %.2f ms)" % [FRAME_BUDGET_MS, worst_all])
	check(median(build_frames) <= median(sync_builds) * BUILD_TOLERANCE,
		"build frame (median %.1f ms) no slower than the synchronous build (median %.1f ms, +%d %% noise allowed)" % [
			median(build_frames), median(sync_builds), int((BUILD_TOLERANCE - 1.0) * 100)])
	check(async_tree == sync_tree, "async tree equals the sync tree (%d nodes)" % sync_tree.size())
	if async_tree != sync_tree:
		for i in range(mini(async_tree.size(), sync_tree.size())):
			if async_tree[i] != sync_tree[i]:
				print("    first difference: async %s | sync %s" % [async_tree[i], sync_tree[i]])
				break
	check(async_cells == sync_cells and sync_cells > 0, "async cells %d == sync cells %d" % [async_cells, sync_cells])


## Every TileMapLayer's tile_map_data by node path.
func layer_blobs(n: Node) -> Dictionary:
	var out := {}
	for l in n.find_children("*", "TileMapLayer", true, false):
		out[str(n.get_path_to(l))] = (l as TileMapLayer).tile_map_data
	if n is TileMapLayer:
		out["."] = (n as TileMapLayer).tile_map_data
	return out


## Loads a map (asynchronously when `threaded`, polling once per frame), builds it with a fresh
## TileSet cache and returns [tree, the builder's timings, whether the map held prepared layers].
func load_and_build(path: String, prepare: bool, threaded: bool, opts: Resource) -> Array:
	var map: RefCounted = ClassDB.instantiate("TiledMap")
	map.set("prepare_tile_layers", prepare)
	if threaded:
		map.call("load_async", path, "")
		while int(map.call("poll")) < READY:
			await process_frame
	else:
		map.call("load", path, "")
	var builder: RefCounted = ClassDB.instantiate("TiledBuilder")
	var n: Node = builder.call("build", map, ClassDB.instantiate("TiledTileSets"), opts)
	return [n, builder.call("get_timings"), map.call("has_prepared_tile_layers")]


## Tile layers prepared by the load (on the worker for load_async, on the main thread for load)
## fill every layer with the blob a build that decodes them itself writes; the build then
## decodes nothing. Several encodings, infinite maps (TMX and JSON), hexagonal flags, legacy
## XML, and alternative tiles (no_alternative_tiles off), and the benchmark map.
func test_prepared_tile_layers() -> void:
	var opts: Resource = ImporterScript.new().call("make_options")
	var alt_opts: Resource = ImporterScript.new().call("make_options")
	alt_opts.set("no_alternative_tiles", false)
	var cases := [
		["layers.tmx", opts], ["encodings.tmx", opts], ["infinite.tmx", opts], ["infinite.tmj", opts],
		["hexagonal.tmx", opts], ["legacy_xml.tmx", opts], ["tilesets.tmx", opts],
		["json_map.tmj", opts], ["isometric.tmx", opts], ["missing_tileset.tmx", opts],
		["layers.tmx", alt_opts], ["infinite.tmx", alt_opts], ["animations.tmx", alt_opts],
	]
	for c in cases:
		var path: String = FIX + c[0]
		var what: String = c[0] + (" (alternative tiles)" if c[1] == alt_opts else "")
		var plain: Array = await load_and_build(path, false, false, c[1])
		var worker: Array = await load_and_build(path, true, true, c[1])
		var main: Array = await load_and_build(path, true, false, c[1])
		var ok: bool = plain[0] != null and worker[0] != null and main[0] != null
		var expected: Dictionary = layer_blobs(plain[0]) if ok else {}
		check(ok and not expected.is_empty() and layer_blobs(worker[0]) == expected
			and layer_blobs(main[0]) == expected and describe(worker[0]) == describe(plain[0]),
			"%s: prepared tile layers (worker and main thread) give the same tile_map_data (%d layers)" % [what, expected.size()])
		check(not plain[2] and worker[2] and main[2], "%s: has_prepared_tile_layers follows prepare_tile_layers" % what)
		for r in [plain, worker, main]:
			if r[0]: r[0].free()
	# The benchmark map: what the build frame no longer does (each tree freed before the next
	# build, the two ways alternated)
	var expected_bench := {}
	var same := true
	var times := {false: [[], [], []], true: [[], [], []]}
	for prepare in [false, true, true, false]:
		var r: Array = await load_and_build(BENCH, prepare, true, opts)
		if r[0] == null:
			same = false
			continue
		var blobs := layer_blobs(r[0])
		if expected_bench.is_empty():
			expected_bench = blobs
		same = same and blobs == expected_bench
		r[0].free()
		var t: Dictionary = r[1]
		times[prepare][0].append(t.prepare_us / 1000.0)
		times[prepare][1].append(t.cells_us / 1000.0)
		times[prepare][2].append(t.assign_us / 1000.0)
		await settle(3)
	var tp: Array = times[false]
	var tq: Array = times[true]
	print("RESULT prepared bench (two builds each): the build decoding its tile layers: decode %s ms, cells %s ms, tile_map_data %s ms; prepared on the worker: decode %s ms, cells %s ms, tile_map_data %s ms" % [
		str(tp[0]), str(tp[1]), str(tp[2]), str(tq[0]), str(tq[1]), str(tq[2])])
	check(same and not expected_bench.is_empty(), "bench: prepared tile layers give the same tile_map_data")
	check(tq[0].max() < 1.0, "bench: a prepared map's build decodes nothing (%.2f ms)" % tq[0].max())


## A second map on the same tilesets (the tiles-only benchmark map has the full map's tileset
## list) creates no TileSet: through a TiledTileSets directly, and through the facade.
func test_second_import_skips_tilesets() -> void:
	var tilesets: RefCounted = ClassDB.instantiate("TiledTileSets")
	var a: RefCounted = ClassDB.instantiate("TiledMap")
	a.call("load", BENCH, "")
	var t := Time.get_ticks_usec()
	var ts_a: TileSet = tilesets.call("tileset_for", a, null)
	var first_ms := (Time.get_ticks_usec() - t) / 1000.0
	var created: int = tilesets.call("get_created_count")
	var cached: int = tilesets.call("get_cached_count")
	var b: RefCounted = ClassDB.instantiate("TiledMap")
	b.call("load", BENCH_TILES, "")
	t = Time.get_ticks_usec()
	var ts_b: TileSet = tilesets.call("tileset_for", b, null)
	var second_ms := (Time.get_ticks_usec() - t) / 1000.0
	print("RESULT second map on the same tilesets: first TileSet %.2f ms, second %.3f ms; created %d -> %d, cached %d -> %d" % [
		first_ms, second_ms, created, tilesets.call("get_created_count"), cached, tilesets.call("get_cached_count")])
	check(ts_a == ts_b, "the second map gets the first map's TileSet")
	check(int(tilesets.call("get_created_count")) == created, "no TileSet created for the second map")
	check(int(tilesets.call("get_cached_count")) == cached, "cached count unchanged")
	check(second_ms < 0.5, "tileset time of the second map ~0 ms (%.3f ms)" % second_ms)
	# A tree built from the shared TileSet, both trees alive at once (exclusive off); the first
	# build also creates the template's TileSet
	var tree_a: Node = ClassDB.instantiate("TiledBuilder").call("build", a, tilesets, null)
	created = tilesets.call("get_created_count")
	var tree_b: Node = ClassDB.instantiate("TiledBuilder").call("build", b, tilesets, null)
	var la := tree_a.find_children("*", "TileMapLayer", true, false)[0] as TileMapLayer
	var lb := tree_b.find_children("*", "TileMapLayer", true, false)[0] as TileMapLayer
	check(la.tile_set == lb.tile_set, "non-exclusive cache: two live trees share the TileSet by reference")
	check(int(tilesets.call("get_created_count")) == created, "building both trees created no TileSet")
	tree_a.free()
	tree_b.free()

	# Through the facade: an async import of the map whose tree was freed reuses its TileSet
	cold_caches()
	var imp: Object = ImporterScript.new()
	var n1: Node = await imp.import_async(BENCH)
	n1.free()
	created = shared().call("get_created_count")
	cached = shared().call("get_cached_count")
	_stamps.clear()
	var n2: Node = await imp.import_async(BENCH_TILES)
	print("RESULT facade second import (tiles-only map after the full map's tree was freed): created %d -> %d, cached %d -> %d, %d frames" % [
		created, shared().call("get_created_count"), cached, shared().call("get_cached_count"), _stamps.size()])
	check(int(shared().call("get_created_count")) == created, "facade: second import created no TileSet")
	check(int(shared().call("get_cached_count")) == cached, "facade: cached count unchanged")
	check(imp.last_error_count == 0, "facade: second import without errors")
	n2.free()


## The facade's shared cache is exclusive: while a tree holds a TileSet, an import of a map with
## the same tilesets gets a second one (as with a fresh cache); once freed, it is reused.
func test_exclusive_shared_cache() -> void:
	cold_caches()
	var imp: Object = ImporterScript.new()
	var a: Node = imp.import(FIX + "tilesets.tmx")
	var b: Node = imp.import(FIX + "tilesets.tmx")
	var la := a.find_children("*", "TileMapLayer", true, false)[0] as TileMapLayer
	var lb := b.find_children("*", "TileMapLayer", true, false)[0] as TileMapLayer
	check(la.tile_set != lb.tile_set, "exclusive: two live trees get two TileSets")
	var created: int = shared().call("get_created_count")
	b.free()
	var c: Node = imp.import(FIX + "tilesets.tmx")
	var lc := c.find_children("*", "TileMapLayer", true, false)[0] as TileMapLayer
	check(int(shared().call("get_created_count")) == created, "exclusive: a freed tree's TileSet is reused")
	check(lc.tile_set != la.tile_set, "exclusive: the reused TileSet is not the live tree's")
	a.free()
	c.free()
	var off: Object = ImporterScript.new()
	off.set("share_tilesets", false)
	var before: int = shared().call("get_created_count")
	var d: Node = off.import(FIX + "tilesets.tmx")
	check(int(shared().call("get_created_count")) == before, "share_tilesets off: the shared cache is not used")
	d.free()


## The project file is part of the key: its custom types go into the tilesets.
func test_project_in_key() -> void:
	cold_caches()
	var imp: Object = ImporterScript.new()
	var a: Node = imp.import(FIX + "objects.tmx", FIX + "custom.tiled-project")
	a.free()
	var created: int = shared().call("get_created_count")
	var b: Node = imp.import(FIX + "objects.tmx", FIX + "custom.tiled-project")
	b.free()
	check(int(shared().call("get_created_count")) == created, "same map, same project: TileSet reused")
	var c: Node = imp.import(FIX + "objects.tmx")
	c.free()
	check(int(shared().call("get_created_count")) > created, "same map without the project: a TileSet of its own")


## Cancelling or dropping a load mid-parse or with texture loads in flight leaves nothing behind.
func test_cancel_leaks_nothing() -> void:
	cold_caches()
	await settle()
	# One full cycle first, so static state (the threaded loader's own) exists before the baseline
	var w: RefCounted = ClassDB.instantiate("TiledMap")
	w.call("load_async", BENCH, "")
	while int(w.call("poll")) < READY:
		await process_frame
	w = null
	await settle()
	var baseline := int(Performance.get_monitor(Performance.OBJECT_COUNT))

	# Cancelled while the worker parses
	var m: RefCounted = ClassDB.instantiate("TiledMap")
	m.call("load_async", BENCH, "")
	var st: int = m.call("poll")
	check(st == PARSING, "after the first poll the worker parses (status %d)" % st)
	m.call("cancel")
	check(int(m.call("poll")) == FAILED and not bool(m.call("is_loaded")), "a cancelled load polls FAILED, nothing loaded")
	m = null

	# Dropped without cancel while it parses
	var d: RefCounted = ClassDB.instantiate("TiledMap")
	d.call("load_async", BENCH, "")
	d.call("poll")
	d = null

	# Cancelled with textures in flight (cold texture cache)
	var reached_waiting := false
	for attempt in range(5):
		await settle(3)
		var t: RefCounted = ClassDB.instantiate("TiledMap")
		t.call("load_async", FIX + "tilesets.tmx", "")
		var s: int = t.call("poll")
		while s < WAITING_FILES:
			await process_frame
			s = t.call("poll")
		if s == WAITING_FILES:
			reached_waiting = true
			t.call("cancel")
			t = null
			break
		t = null
	print("  texture-load cancel case %s" % ("exercised" if reached_waiting else "not reached (textures loaded within a frame)"))

	var probe: RefCounted = ClassDB.instantiate("TiledMap")
	var threads := -1
	var orphans := -1
	for i in range(200):
		await process_frame
		threads = probe.call("get_running_loaders")
		orphans = probe.call("get_orphaned_texture_requests")
		if threads == 0 and orphans == 0:
			break
		OS.delay_msec(5)
	probe = null
	await settle()
	var after := int(Performance.get_monitor(Performance.OBJECT_COUNT))
	print("RESULT cancel: objects %d -> %d, loader threads left %d, texture requests left %d" % [baseline, after, threads, orphans])
	check(threads == 0, "no loader thread left after cancelling")
	check(orphans == 0, "every orphaned texture request collected")
	check(after == baseline, "OBJECT_COUNT back to its baseline (%d -> %d)" % [baseline, after])


## `loaded` is emitted from poll(); a handler may call back into the map. `failed` likewise.
func test_signals() -> void:
	var m: RefCounted = ClassDB.instantiate("TiledMap")
	var seen: Array = []
	var on_loaded := func() -> void: seen.append(m.call("get_size"))
	m.connect("loaded", on_loaded)
	m.call("load_async", FIX + "layers.tmx", "")
	var frames := 0
	while int(m.call("poll")) < READY:
		frames += 1
		await process_frame
	check(seen.size() == 1, "loaded emitted once (%d)" % seen.size())
	check(seen.size() == 1 and seen[0] == m.call("get_size") and m.call("get_size") != Vector2i.ZERO,
		"the loaded handler read the map from inside poll()")
	check(int(m.call("poll")) == READY and seen.size() == 1, "poll after the end only reports READY")
	m.disconnect("loaded", on_loaded) # the lambda holds the map: a cycle otherwise
	var f: RefCounted = ClassDB.instantiate("TiledMap")
	var failed := [0]
	var on_failed := func() -> void: failed[0] += 1
	f.connect("failed", on_failed)
	f.call("load_async", FIX + "does_not_exist.tmx", "")
	while int(f.call("poll")) < READY:
		await process_frame
	check(int(f.call("get_status")) == FAILED and failed[0] == 1, "failed emitted once for a missing map")
	check((f.call("get_errors") as PackedStringArray).size() == 1, "the missing map's error is kept")
	f.disconnect("failed", on_failed)


## Small maps and the zip archive: the async tree equals the sync one.
func test_small_and_zip_equal_sync() -> void:
	for f in ["layers.tmx", "objects.tmx", "templates.tmx", "infinite.tmx", "animations.tmx", "json_map.tmj"]:
		var imp: Object = ImporterScript.new()
		var project := FIX + "custom.tiled-project" if f == "objects.tmx" else ""
		var s: Node = imp.import(FIX + f, project)
		var a: Node = await imp.import_async(FIX + f, project)
		check(s != null and a != null and describe(s) == describe(a), "async %s equals sync" % f)
		if s: s.free()
		if a: a.free()
	var zimp: Object = ImporterScript.new()
	var zs: Node = zimp.import_from_zip(FIX + "bundle.zip", "maps/zipmap.tmx")
	var zs_errors: int = zimp.last_error_count
	var za: Node = await zimp.import_from_zip_async(FIX + "bundle.zip", "maps/zipmap.tmx")
	check(zs != null and za != null and describe(zs) == describe(za), "async zip import equals sync")
	check(zimp.last_error_count == zs_errors, "zip: same error count")
	if zs: zs.free()
	if za: za.free()


## Errors and warnings counted as by the synchronous import; a fatal error returns null.
func test_failures_and_counts() -> void:
	var imp: Object = ImporterScript.new()
	var s: Node = imp.import(FIX + "missing_tileset.tmx")
	var se: int = imp.last_error_count
	var sw: int = imp.last_warning_count
	var a: Node = await imp.import_async(FIX + "missing_tileset.tmx")
	check(imp.last_error_count == se and imp.last_warning_count == sw,
		"missing_tileset.tmx: async counts %d/%d == sync %d/%d" % [imp.last_error_count, imp.last_warning_count, se, sw])
	if s: s.free()
	if a: a.free()
	var n: Node = await imp.import_async(FIX + "does_not_exist.tmx")
	check(n == null and imp.last_error_count == 1, "a missing map: null and one error")
	var z: Node = await imp.import_from_zip_async(FIX + "no_such.zip", "maps/zipmap.tmx")
	check(z == null and imp.last_error_count == 1, "a missing zip archive: null and one error")
